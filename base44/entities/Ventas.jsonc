{
  "name": "Ventas",
  "type": "object",
  "properties": {
    "fecha_hora": {
      "type": "string",
      "format": "date-time",
      "title": "Fecha y hora"
    },
    "monto_total": {
      "type": "number",
      "title": "Monto total"
    },
    "metodo_pago": {
      "type": "string",
      "enum": [
        "EFECTIVO",
        "TARJETA",
        "SINPE",
        "TRANSFERENCIA",
        "OTRO",
        "Fiado",
        "Efectivo",
        "Tarjeta",
        "Transferencia",
        "Otro"
      ],
      "title": "M\u00e9todo de pago"
    },
    "cliente_id": {
      "type": "string",
      "title": "Cliente"
    },
    "caja_id": {
      "type": "string",
      "title": "Caja"
    },
    "usuario_id": {
      "type": "string",
      "title": "Usuario que realiz\u00f3 la venta"
    },
    "descuento": {
      "type": "number",
      "default": 0,
      "title": "Descuento"
    },
    "recibido": {
      "type": "number",
      "title": "Dinero recibido (efectivo)"
    },
    "vuelto": {
      "type": "number",
      "default": 0,
      "title": "Vuelto"
    },
    "estado": {
      "type": "string",
      "enum": [
        "COMPLETADA",
        "ANULADA",
        "DEVUELTA",
        "Pendiente",
        "Pagado",
        "Anulada",
        "Devuelta"
      ],
      "default": "COMPLETADA",
      "title": "Estado"
    },
    "motivo_anulacion": {
      "type": "string",
      "title": "Motivo de anulaci\u00f3n"
    }
  },
  "required": [
    "monto_total",
    "metodo_pago"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        }
      ]
    }
  }
}