{
  "name": "Ventas",
  "type": "object",
  "properties": {
    "fecha_hora": {
      "type": "string",
      "format": "date-time",
      "title": "Fecha y hora"
    },
    "monto_total": {
      "type": "number",
      "title": "Monto total"
    },
    "metodo_pago": {
      "type": "string",
      "enum": [
        "Efectivo",
        "Tarjeta",
        "Transferencia",
        "Fiado"
      ],
      "title": "M\u00e9todo de pago"
    },
    "cliente_id": {
      "type": "string",
      "title": "Cliente"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Pagado",
        "Pendiente",
        "Anulada"
      ],
      "default": "Pagado",
      "title": "Estado"
    },
    "motivo_anulacion": {
      "type": "string",
      "title": "Motivo de anulaci\u00f3n"
    }
  },
  "required": [
    "monto_total",
    "metodo_pago"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}