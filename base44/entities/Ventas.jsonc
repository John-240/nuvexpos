{
  "name": "Ventas",
  "type": "object",
  "properties": {
    "fecha_hora": {
      "type": "string",
      "format": "date-time",
      "title": "Fecha y hora"
    },
    "monto_total": {
      "type": "number",
      "title": "Monto total"
    },
    "metodo_pago": {
      "type": "string",
      "enum": [
        "Efectivo",
        "Tarjeta",
        "Transferencia"
      ],
      "title": "M\u00e9todo de pago"
    }
  },
  "required": [
    "monto_total",
    "metodo_pago"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}