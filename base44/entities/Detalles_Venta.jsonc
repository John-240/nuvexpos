{
  "name": "Detalles_Venta",
  "type": "object",
  "properties": {
    "venta_id": {
      "type": "string",
      "title": "Venta"
    },
    "producto_id": {
      "type": "string",
      "title": "Producto"
    },
    "cantidad_vendida": {
      "type": "integer",
      "title": "Cantidad vendida"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal"
    }
  },
  "required": [
    "venta_id",
    "producto_id",
    "cantidad_vendida",
    "subtotal"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}