{
  "name": "Aprobaci\u00f3n de Ventas Mayores a 500",
  "description": "Cuando se registra una venta, delega a solicitar_aprobacion_venta la decisi\u00f3n de notificar al gerente seg\u00fan el monto m\u00e1ximo configurado en la entidad Configuracion (default 50000).",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Ventas",
      "events": [
        "create"
      ]
    },
    "condition": "${ true }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "aprobacion_venta_grande",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "solicitar_aprobacion": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "solicitar_aprobacion_venta",
            "args": {
              "venta_id": "${ .trigger.entity_id }",
              "monto_total": "${ .trigger.data.monto_total }",
              "metodo_pago": "${ .trigger.data.metodo_pago }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Solicitar aprobaci\u00f3n al gerente",
            "description": "Eval\u00faa el monto m\u00e1ximo configurado y, si la venta lo supera, crea alerta y env\u00eda correo al gerente"
          }
        }
      }
    ]
  }
}